{
  "openapi": "3.1.0",
  "info": {
    "title": "Users Mock API",
    "description": "A sample REST API for automated testing. Data is stored in memory and reset whenever the app is created.",
    "version": "1.0.0"
  },
  "paths": {
    "/users": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "List users",
        "description": "Return all users sorted by ID.",
        "operationId": "list_users",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/UserResponse"
                  },
                  "type": "array",
                  "title": "Response List Users"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "users"
        ],
        "summary": "Create a user",
        "description": "Create a user after validating uniqueness and field constraints.",
        "operationId": "create_user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "links": {
              "GetCreatedUser": {
                "operationId": "get_user",
                "parameters": {
                  "user_id": "$response.body#/id"
                },
                "description": "Fetch the user that was just created"
              }
            }
          },
          "400": {
            "description": "Request body could not be decoded (e.g. invalid UTF-8)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "409": {
            "description": "A user with this email already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed (including syntactically invalid JSON)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/users/{user_id}": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Get a user by ID",
        "description": "Return a user or a structured 404 error.",
        "operationId": "get_user",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "The positive ID of the user",
              "title": "User Id"
            },
            "description": "The positive ID of the user"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed (including syntactically invalid JSON)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "examples": [
              "USER_NOT_FOUND"
            ]
          },
          "message": {
            "type": "string",
            "title": "Message",
            "examples": [
              "User with ID 42 was not found"
            ]
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "description": "Machine-readable application error."
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "description": "Body of errors raised via HTTPException(detail={...})."
      },
      "MessageResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "examples": [
              "There was an error parsing the body"
            ]
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "MessageResponse",
        "description": "Body of 400 responses produced by FastAPI when the body cannot be decoded."
      },
      "UserCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "examples": [
              "Alice"
            ]
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email",
            "examples": [
              "new.user@example.com"
            ]
          },
          "age": {
            "type": "integer",
            "maximum": 65.0,
            "minimum": 18.0,
            "title": "Age",
            "examples": [
              30
            ]
          }
        },
        "type": "object",
        "required": [
          "name",
          "email",
          "age"
        ],
        "title": "UserCreate",
        "description": "Request contract for creating a user."
      },
      "UserResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Id",
            "examples": [
              1
            ]
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "age": {
            "type": "integer",
            "maximum": 65.0,
            "minimum": 18.0,
            "title": "Age"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "age"
        ],
        "title": "UserResponse",
        "description": "Response contract returned by the user endpoints."
      },
      "ValidationErrorItem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "msg": {
            "type": "string",
            "title": "Msg"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "type",
          "loc",
          "msg"
        ],
        "title": "ValidationErrorItem",
        "description": "One FastAPI/Pydantic validation error."
      },
      "ValidationErrorResponse": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationErrorItem"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ValidationErrorResponse",
        "description": "Body of 422 responses produced by request validation."
      }
    }
  }
}
